# ─── Supabase ────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key
SUPABASE_SERVICE_KEY=your_service_role_key

# ─── Configuration IA : Google Gemini (fournisseur principal) ───
# Créez une clé GRATUITE sur https://aistudio.google.com/apikey
# Modèles par défaut : gemini-3.6-flash (texte) et gemini-3.6-flash-image (images)
GEMINI_API_KEY=your_gemini_api_key
# (Optionnel) Surcharger les modèles si Google renomme/retire une version :
# GEMINI_MODEL=gemini-3.6-flash
# GEMINI_IMAGE_MODEL=gemini-3.6-flash-image

# (Optionnel) Fournisseurs de repli via clés officielles directes :
# ANTHROPIC_API_KEY=sk-ant-xxxx
# OPENAI_API_KEY=sk-proj-xxxx
# GITHUB_TOKEN=your_github_token_here
# ANTHROPIC_MODEL=claude-opus-4-8
# OPENAI_MODEL=gpt-5.6-sol

# ─── Meta (Facebook OAuth) ───────────────────────────────
META_APP_ID=your_meta_app_id
META_APP_SECRET=your_meta_app_secret
META_REDIRECT_URI=https://cms12.vercel.app/api/auth/meta/callback

# ─── Instagram (OAuth direct sans Page Facebook) ─────────
INSTAGRAM_APP_ID=your_instagram_app_id
INSTAGRAM_APP_SECRET=your_instagram_app_secret
INSTAGRAM_REDIRECT_URI=https://cms12.vercel.app/api/auth/instagram/callback

# ─── Ayrshare (plans payants) ────────────────────────────
AYRSHARE_API_KEY=your_ayrshare_api_key

# ─── Stripe ──────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_live_xxxx
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_xxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxx
STRIPE_PRICE_PREMIUM=price_xxxx
STRIPE_PRICE_BUSINESS=price_xxxx

# ─── Sécurité ────────────────────────────────────────────
# Clé AES-256 pour chiffrement tokens OAuth (32 bytes = 64 chars hex)
# Générer : node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
TOKEN_ENCRYPTION_KEY=your_64_char_hex_key

# Secret partagé entre Vercel Cron et l'app
# Générer : node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CRON_SECRET=your_cron_secret

# ─── App ─────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=https://yourdomain.com
